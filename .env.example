# PromptPay Guard Configuration
PORT=3000
HOST=localhost

# Google Gemini API Key for Tier-2 Semantic Intent Classification
# Get your API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# PayPal Sandbox REST API Credentials
# Get credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=7F072555EA7227937
PAYPAL_WEBHOOK_URL=https://washing-division-shakiness.ngrok-free.dev/api/v1/paypal-webhook

# Tier-1 Fast Heuristics Engine Limits
# Maximum transactions allowed per sliding window (60s)
TIER1_MAX_VELOCITY_PER_WINDOW=5
TIER1_VELOCITY_WINDOW_SECONDS=60

# Budget constraints (in USD)
TIER1_SINGLE_TRANSACTION_LIMIT=100.00
TIER1_DAILY_CUMULATIVE_LIMIT=500.00

# Tier-2 Semantic Classification Threat Threshold (0 to 100)
# Threat score above this triggers immediate rejection
TIER2_THREAT_THRESHOLD=40

# Simulation / Mock Mode
# If true and credentials are not provided, uses realistic PayPal Sandbox mock responses
ENABLE_MOCK_FALLBACK=true
